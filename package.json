{
  "name": "zenith-app-max",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-legacy.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-legacy.mjs && node scripts/fix-database-urls.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "benchmark:phase1": "node scripts/benchmark-player-ssr.mjs --samples 50",
    "generate:top-players": "node scripts/generate-top-players.mjs --limit 10000 --output src/data/top-players.json",
    "revalidate:call": "node scripts/call-revalidate.mjs",
    "rollout:status": "node scripts/rollout-status.mjs",
    "db:migrate:blog": "node scripts/db/run-blog-migrations.mjs",
    "db:seed:blog-users": "node scripts/db/seed-blog-users.mjs",
    "legacy:sync-css": "powershell -NoProfile -Command \"$env:SYNC_LEGACY_CSS='1'; node scripts/prepare-legacy.mjs\"",
    "test:price": "node scripts/test-price-snapshot-utils.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "chart.js": "^4.5.1",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.3.1",
    "html2canvas": "^1.4.1",
    "next": "^14.2.35",
    "p-limit": "^7.3.1",
    "pg": "^8.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.68",
    "@playwright/test": "^1.60.0",
    "@types/react": "19.2.14",
    "playwright": "^1.58.2",
    "typescript": "5.9.3"
  }
}
